# ==============================================================================
# Aiven MySQL Database Configuration
# ==============================================================================

# Option 1: Using Aiven's Service URI (Recommended - Single Variable)
# Copy "Service URI" directly from your Aiven Console Overview tab:
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-xxxx.aivencloud.com:18942/defaultdb?ssl-mode=REQUIRED

# Option 2: Using Individual Parameters
# Found under Connection Details in your Aiven Console:
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=18942
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
DB_SSL=true

# When deploying to Vercel:
# Add either DATABASE_URL or the individual DB_* variables to:
# Vercel Dashboard -> Your Project -> Settings -> Environment Variables
